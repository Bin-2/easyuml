                     sha256="e6f4a1bb6f75fe148cb5b251080fd9a83b2a70cb624fbb6d6a40f8890e5b0728"/>
        <central-jar path="org/freehep/freehep-io/2.2.2/freehep-io-2.2.2-sources.jar"
                     dir="docs/easyuml-single/easyuml-export-licenses/freehep-sources"
                     sha256="23a51bf34d0ac7175fc8a84e99609f8b7547786e6bc2c28cb40ea61961879f42"/>
        <central-jar path="com/github/javaparser/javaparser-core/2.2.2/javaparser-core-2.2.2-sources.jar"
                     dir="docs/easyuml-single/easyuml-javaparser"
                     sha256="a0b16d6a986a83e7f5ecfebc7bd262bf7379a5a7c70526f69806d389c5ee53d8"/>

        <!-- Prevent stale JARs from entering a package after a version change. -->
        <fail message="Unexpected JARs in the generated release tree. Clean and rebuild after changing dependencies.">
            <condition>
                <not>
                    <resourcecount count="19">
                        <fileset dir="${release.dir}" includes="**/*.jar"/>
                    </resourcecount>
                </not>
            </condition>
        </fail>
    </target>
</project>
