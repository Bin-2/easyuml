                     sha256="29e77eafec23aa272c9f2bce91fa0a831d9437f296f981dc6e960e066311f870"/>
        <central-jar path="org/freehep/freehep-graphicsbase/2.4/freehep-graphicsbase-2.4.jar"
                     dir="modules/ext/easyuml-single/easyuml-export"
                     sha256="d3054b9d5e1534ef3a8f189b0cae2d3c85ad51d2f15a6c61ce8a576c1c647713"/>
        <central-jar path="org/freehep/freehep-graphicsio/2.4/freehep-graphicsio-2.4.jar"
                     dir="modules/ext/easyuml-single/easyuml-export"
                     sha256="f5f884c795d4e4175dd05851125a668054627eb5d6facc9b343b31f14bef4a5c"/>
        <central-jar path="org/freehep/freehep-graphicsio-svg/2.4/freehep-graphicsio-svg-2.4.jar"
