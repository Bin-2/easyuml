<?xml version="1.0" encoding="UTF-8"?>
<project name="easyuml-maven-dependencies" basedir=".." default="resolve-dependencies"
         xmlns:unless="ant:unless">
    <property name="release.dir" location="build/nbm-release"/>

    <macrodef name="central-jar">
        <attribute name="path"/>
        <attribute name="dir"/>
        <attribute name="sha256"/>
        <sequential>
            <local name="artifact.name"/>
            <local name="artifact.file"/>
            <local name="artifact.valid"/>
            <local name="artifact.download"/>
            <basename property="artifact.name" file="@{path}"/>
            <property name="artifact.file" location="${release.dir}/@{dir}/${artifact.name}"/>
            <condition property="artifact.valid">
                <and>
                    <available file="${artifact.file}" type="file"/>
                    <checksum file="${artifact.file}" algorithm="SHA-256" property="@{sha256}"/>
                </and>
            </condition>
            <sequential unless:set="artifact.valid">
                <mkdir dir="${release.dir}/@{dir}"/>
                <!-- Verify the download before replacing the cached artifact. -->
                <tempfile property="artifact.download" destdir="${basedir}/build"
                          prefix="central-" suffix=".part" createfile="true" deleteonexit="true"/>
                <get src="https://repo.maven.apache.org/maven2/@{path}" dest="${artifact.download}"
                     maxtime="90" retries="2"/>
                <fail message="SHA-256 mismatch for Maven Central artifact @{path}">
                    <condition>
                        <not>
                            <checksum file="${artifact.download}" algorithm="SHA-256" property="@{sha256}"/>
                        </not>
                    </condition>
                </fail>
                <move file="${artifact.download}" tofile="${artifact.file}" overwrite="true"/>
            </sequential>
        </sequential>
    </macrodef>

    <!-- The icon generation helper needs only JSVG. -->
    <target name="resolve-jsvg">
        <central-jar path="com/github/weisj/jsvg/1.7.1/jsvg-1.7.1.jar"
                     dir="modules/ext/easyuml-single/easyuml-svg"
                     sha256="b68e541ace91ad17f098859395db256c4618363c7b7781517fac860f2a0014c4"/>
    </target>

    <target name="resolve-dependencies" depends="resolve-jsvg">
        <copy todir="${release.dir}">
            <fileset dir="release" excludes="**/*.jar"/>
        </copy>

        <central-jar path="org/dom4j/dom4j/2.1.5/dom4j-2.1.5.jar"
                     dir="modules/ext/easyuml-single"
                     sha256="c45367e490d6c818d4c990bf9682e7766822d66324b6087e14d50e940383fa75"/>
        <central-jar path="com/github/javaparser/javaparser-core/2.2.2/javaparser-core-2.2.2.jar"
                     dir="modules/ext/easyuml-single"
                     sha256="d68380c2d9e36dacb71e96e8e78810e9c68015dfa4737e236a824b788b863533"/>
        <central-jar path="commons-logging/commons-logging/1.4.0/commons-logging-1.4.0.jar"
                     dir="modules/ext/easyuml-single/easyuml-export"
                     sha256="d175dbd751dd782a63bde28c7a039520e971f25e84b79c19b8435edc3603e0dc"/>
        <central-jar path="org/apache/pdfbox/fontbox/3.0.8/fontbox-3.0.8.jar"
