                     dir="docs/easyuml-single/easyuml-export-licenses/freehep-sources"
                     sha256="8cea652bbd270af5be1364126ef6ecd5557b8def5281bae782e44ac10b35a5fa"/>
        <central-jar path="org/freehep/freehep-graphicsbase/2.4/freehep-graphicsbase-2.4-sources.jar"
